APP_API_KEY=change-me

DATABASE_URL=postgresql+asyncpg://groundwork:groundwork@postgres:5432/groundwork
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10

# ollama (default) | openai_compat. Ollama is the only required provider; the hosted one exists
# because a RAG turn measured 67.9s on the largest instance the AWS Free plan allows, against
# 8.1s on Metal. See backend/evals/baselines/deployment_inference.md.
LLM_PROVIDER=ollama
# Ollama runs on the host, not in Docker: Docker Desktop cannot reach the Apple Silicon GPU,
# and the same model measured 7.2 tok/s containerised against 40 tok/s natively.
# Set this to http://ollama:11434 when running `docker compose --profile bundled-ollama up`.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=60
# Reasoning models: off by default. Measured 44.7s -> 6.1s on qwen3:8b with no quality loss.
OLLAMA_THINK=false
LLM_FALLBACK_ENABLED=true

GRADER_ENABLED=true
GRADER_MODEL=llama3.2:3b
GRADER_TIMEOUT_SECONDS=30
CORRECTIVE_MAX_ATTEMPTS=2

# Optional. Without a key the web fallback is disabled and unanswerable questions simply
# disclose the gap.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=4

# Hosted chat provider, used in deployment only. Chat moves; embeddings never do -- the schema
# hardcodes Vector(dim=768) from embeddinggemma, and a different embedding model is a different
# vector space, which retrieval would not error on, only return nonsense.
HOSTED_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
HOSTED_MODEL=openai/gpt-oss-120b
HOSTED_GRADER_MODEL=openai/gpt-oss-20b
# The entailment judge. Defaults to the grader-class model; separate so it can be moved off that
# model's daily budget, which grading and entailment currently share.
HOSTED_ENTAILMENT_MODEL=openai/gpt-oss-20b
# The counterpart of OLLAMA_THINK. Measured on gpt-oss-20b: default effort spent 190 of 205
# completion tokens on reasoning against 25 of 63 at low, for a job returning one bit.
HOSTED_REASONING_EFFORT=low

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSION=768

GITHUB_TOKEN=
GITHUB_SYNC_OVERLAP_MINUTES=10
GITHUB_SYNC_STALE_AFTER_MINUTES=60
GITHUB_SYNC_MAX_COMMITS=500
GITHUB_SYNC_RUNNING_TIMEOUT_MINUTES=15

JIRA_SITE_URL=
JIRA_CLOUD_ID=
JIRA_PROJECT_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SYNC_OVERLAP_MINUTES=10
JIRA_SYNC_STALE_AFTER_MINUTES=60
JIRA_SYNC_MAX_ISSUES=500
JIRA_SYNC_RUNNING_TIMEOUT_MINUTES=15

SLACK_BOT_TOKEN=
SLACK_WORKSPACE_DOMAIN=
SLACK_SYNC_OVERLAP_MINUTES=10
SLACK_SYNC_STALE_AFTER_MINUTES=60
SLACK_SYNC_MAX_MESSAGES=500
SLACK_SYNC_RUNNING_TIMEOUT_MINUTES=15

# JSON logs on stdout, which is what docker logs and every shipper reads.
LOG_LEVEL=INFO

# Rate limiting. Two ceilings: per caller, and a global one because Groq's free tier is counted
# per organization -- twenty callers each under the per-client limit would drain it between them.
#
# Disabled locally because the eval suites fire far more than this by design: the conversation
# runner sends 186 requests in a few minutes from one address. Production sets it true.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_CLIENT=20
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_WINDOW_SECONDS=60

# Refresh every project's connected sources when the process starts. Off by default so that
# importing the app never reaches the network. The deployment sets it in docker-compose.prod.yml,
# where the instance is stopped between demos and wakes with a stale index.
STARTUP_SYNC_ENABLED=false

BACKEND_CORS_ORIGINS=http://localhost:3000
# Backend URL used by the Next.js server-side proxy (app/api/[...path]/route.ts).
# Deliberately not NEXT_PUBLIC: anything with that prefix is inlined into the browser bundle,
# which is how the API key used to end up readable by every visitor. The browser calls /api on
# its own origin and never sees APP_API_KEY.
API_BASE_URL=http://localhost:8000
