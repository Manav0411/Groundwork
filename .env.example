APP_API_KEY=change-me

DATABASE_URL=postgresql+asyncpg://groundwork:groundwork@postgres:5432/groundwork
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=120
# Reasoning models: off by default. Measured 44.7s -> 6.1s on qwen3:8b with no quality loss.
OLLAMA_THINK=false
LLM_FALLBACK_ENABLED=true

GRADER_ENABLED=true
GRADER_MODEL=llama3.2:3b
GRADER_TIMEOUT_SECONDS=45
CORRECTIVE_MAX_ATTEMPTS=2

# Optional. Without a key the web fallback is disabled and unanswerable questions simply
# disclose the gap.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=4

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSION=768

GITHUB_TOKEN=
GITHUB_SYNC_OVERLAP_MINUTES=10
GITHUB_SYNC_STALE_AFTER_MINUTES=60
GITHUB_SYNC_MAX_COMMITS=500
GITHUB_SYNC_RUNNING_TIMEOUT_MINUTES=15

JIRA_SITE_URL=
JIRA_CLOUD_ID=
JIRA_PROJECT_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SYNC_OVERLAP_MINUTES=10
JIRA_SYNC_STALE_AFTER_MINUTES=60
JIRA_SYNC_MAX_ISSUES=500
JIRA_SYNC_RUNNING_TIMEOUT_MINUTES=15

SLACK_BOT_TOKEN=
SLACK_WORKSPACE_DOMAIN=
SLACK_SYNC_OVERLAP_MINUTES=10
SLACK_SYNC_STALE_AFTER_MINUTES=60
SLACK_SYNC_MAX_MESSAGES=500
SLACK_SYNC_RUNNING_TIMEOUT_MINUTES=15

BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_API_KEY=change-me
